DATABASE_URL=postgresql+psycopg://user:password@host/database
# Generate a long random value and keep it stable. Changing it signs every
# browser out of its anonymous dashboard workspace.
ANONYMOUS_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Set to true when the API is served over HTTPS.
COOKIE_SECURE=false
# Exact frontend origins as a JSON array.
CORS_ORIGINS=["http://localhost:3000"]
OPENAI_API_KEY=replace-with-your-api-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=smart-data-analyzer-files
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Dataset upload limits
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=250000
MAX_DATASET_COLUMNS=200

# Demo-only in-memory AI usage limits
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=30
AI_CONCURRENT_REQUESTS=1
